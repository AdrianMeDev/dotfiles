// ============================================================================
//  Zed – globale Debug-Konfigurationen (in jedem Projekt verfügbar)
//  Linux: ~/.config/zed/debug.json   Windows: %APPDATA%\Zed\debug.json
//  Projektspezifisch: <projekt>/.zed/debug.json (siehe Vorlagen).
//  Start: F4 oder <space> d d
// ============================================================================
[
  {
    "label": "Python: aktuelle Datei",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Node: aktuelle Datei",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "skipFiles": ["<node_internals>/**"]
  }
]
