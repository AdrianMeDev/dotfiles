// ============================================================================
//  Zed – globale Tasks (in jedem Projekt verfügbar)
//  Linux: ~/.config/zed/tasks.json   Windows: %APPDATA%\Zed\tasks.json
//  Projektspezifische Tasks liegen in <projekt>/.zed/tasks.json (Vorlagen).
//  In WSL-Projekten laufen alle Tasks in der WSL-Shell.
// ============================================================================
[
  {
    "label": "Claude Code (Terminal)",
    "command": "claude",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "tags": ["ai"]
  },
  {
    "label": "Claude Code: letzte Session fortsetzen",
    "command": "claude",
    "args": ["--continue"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "show_summary": false,
    "show_command": false,
    "tags": ["ai"]
  },
  {
    "label": "pi (Terminal)",
    "command": "pi",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "tags": ["ai"]
  },
  {
    "label": "lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "tags": ["git"]
  },
  {
    "label": "git: Log (Graph)",
    "command": "git",
    "args": ["log", "--oneline", "--graph", "--decorate", "-n", "40"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["git"]
  },
  {
    "label": "Suche: TODO / FIXME",
    "command": "rg",
    "args": ["-n", "--no-heading", "TODO|FIXME|HACK"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Ollama: Modelle anzeigen",
    "command": "ollama",
    "args": ["list"],
    "reveal": "always",
    "tags": ["ai"]
  }
]
