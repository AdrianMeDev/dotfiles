[
  {
    "label": "Node: start",
    "command": "npm",
    "args": ["start"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "fish" },
    "allow_concurrent_runs": false
  },
  {
    "label": "Node: test",
    "command": "npm",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "fish" }
  },
  {
    "label": "Node: build",
    "command": "npm",
    "args": ["run", "build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "fish" }
  },
  {
    "label": "Python: pytest",
    "command": "uv",
    "args": ["run", "pytest"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "fish" }
  },
  {
    "label": "Django: runserver (localhost)",
    "command": "uv",
    "args": ["run", "python", "manage.py", "runserver", "127.0.0.1:8000"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "fish" },
    "allow_concurrent_runs": false
  },
  {
    "label": ".NET: build",
    "command": "dotnet",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": ".NET: test",
    "command": "dotnet",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": ".NET: watch",
    "command": "dotnet",
    "args": ["watch", "run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false
  }
]
