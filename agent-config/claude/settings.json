{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "editorMode": "vim",
  "spinnerTipsEnabled": false,
  "preferredNotifChannel": "terminal_bell",
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 30,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(rg *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx ng build *)",
      "Bash(npx ng test *)",
      "Bash(npx ng lint *)",
      "Bash(npx prettier --check *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "Bash(python manage.py check *)",
      "Bash(python manage.py test *)",
      "Bash(python manage.py showmigrations *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(dotnet add *)",
      "Bash(dotnet ef database *)",
      "Bash(python manage.py migrate *)",
      "Bash(docker *)",
      "Bash(kubectl *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/appsettings.*.local.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)"
    ]
  }
}
