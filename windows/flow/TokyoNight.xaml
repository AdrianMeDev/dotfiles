<!-- Flow Launcher theme. Colors and font come from theme/tokens.toml (checked by tests/test_theme.py::test_flow). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BaseWindowBorderStyle}">
        <Setter Property="Background" Value="#1a1b26" />
        <Setter Property="BorderBrush" Value="#7aa2f7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style x:Key="QueryBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseQueryBoxStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#c0caf5" />
        <Setter Property="CaretBrush" Value="#c0caf5" />
        <Setter Property="SelectionBrush" Value="#292e42" />
    </Style>
    <Style x:Key="QuerySuggestionBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#565f89" />
    </Style>
    <Style x:Key="PendingLineStyle" TargetType="{x:Type Line}" BasedOn="{StaticResource BasePendingLineStyle}">
        <Setter Property="Stroke" Value="#7aa2f7" />
    </Style>
    <Style x:Key="SeparatorStyle" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource BaseSeparatorStyle}">
        <Setter Property="Fill" Value="#414868" />
    </Style>
    <Style x:Key="ItemTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseItemTitleStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#c0caf5" />
    </Style>
    <Style x:Key="ItemSubTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseItemSubTitleStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#565f89" />
    </Style>
    <Style x:Key="ItemTitleSelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseItemTitleSelectedStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#c0caf5" />
    </Style>
    <Style x:Key="ItemSubTitleSelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}">
        <Setter Property="FontFamily" Value="Ioskeley Mono" />
        <Setter Property="Foreground" Value="#a9b1d6" />
    </Style>
    <Style x:Key="ItemGlyphStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseGlyphStyle}">
        <Setter Property="Foreground" Value="#a9b1d6" />
    </Style>
    <Style x:Key="ItemGlyphSelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseGlyphStyle}">
        <Setter Property="Foreground" Value="#c0caf5" />
    </Style>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor" Color="#292e42" />
    <SolidColorBrush x:Key="ItemSelectedHoverBackgroundColor" Color="#292e42" />
    <SolidColorBrush x:Key="ThumbColor" Color="#414868" />
</ResourceDictionary>
