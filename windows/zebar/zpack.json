{
  "$schema": "https://raw.githubusercontent.com/glzr-io/zebar/main/resources/zpack-schema.json",
  "name": "dotfiles",
  "version": "1.0.0",
  "widgets": [{
    "name": "bar", "htmlPath": "index.html", "zOrder": "top_most",
    "shownInTaskbar": false, "focused": false, "resizable": false, "transparent": false,
    "presets": [{
      "name": "top", "anchor": "top_left", "offsetX": "0px", "offsetY": "0px",
      "width": "100%", "height": "32px", "monitorSelection": { "type": "all" }
    }]
  }]
}
