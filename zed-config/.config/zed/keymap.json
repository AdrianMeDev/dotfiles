// ============================================================================
//  Zed – Keymap (Vim, QWERTY, Leader = Leertaste)
//  Linux: ~/.config/zed/keymap.json   Windows: %APPDATA%\Zed\keymap.json
//
//  <space> drücken und kurz warten → Which-Key zeigt alle Folgetasten.
//  Gruppen:  f Finden · p Projekt · w Fenster · c Code · g Git · r Run/Tasks
//            t Terminal · d Debug · a KI/Agents · m Markdown
// ============================================================================
[
  // ── Global (überall im Fenster) ───────────────────────────────────────────
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-p": "file_finder::Toggle",
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-`": "terminal_panel::ToggleFocus",
      "ctrl-shift-a": "agent::ToggleFocus",
      "ctrl-shift-e": "project_panel::ToggleFocus",
      "ctrl-shift-g": "git_panel::ToggleFocus",

      // Debugger (VS-Code-ähnlich)
      "f4": "debugger::Start",
      "f5": "debugger::Continue",
      "shift-f5": "debugger::Stop",
      "ctrl-shift-f5": "debugger::Restart",
      "f6": "debugger::Pause",
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "shift-f11": "debugger::StepOut"
    }
  },

  // ── Tabs per Nummer: Zeds Standard alt-1..9 gehört dem Fenstermanager
  //    (Workspaces), daher ctrl-1..9. Überschreibt workspace::ActivatePane.
  {
    "context": "Pane",
    "bindings": {
      "ctrl-1": ["pane::ActivateItem", 0],
      "ctrl-2": ["pane::ActivateItem", 1],
      "ctrl-3": ["pane::ActivateItem", 2],
      "ctrl-4": ["pane::ActivateItem", 3],
      "ctrl-5": ["pane::ActivateItem", 4],
      "ctrl-6": ["pane::ActivateItem", 5],
      "ctrl-7": ["pane::ActivateItem", 6],
      "ctrl-8": ["pane::ActivateItem", 7],
      "ctrl-9": "pane::ActivateLastItem"
    }
  },

  // ── Leader-Tasten: Editor (Normal/Visual), leere Pane, Projekt-/Outline-Panel
  {
    "context": "(VimControl && !menu) || EmptyPane || SharedScreen || (ProjectPanel && not_editing) || (OutlinePanel && not_editing)",
    "bindings": {
      // Zeds Vim-Standard belegt `space` allein (Cursor nach rechts). Dadurch ist das Präfix
      // mehrdeutig und läuft nach ~1 s ab. `null` entfernt die Belegung → Which-Key bleibt offen.
      "space": null,

      // f – Finden
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space /": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space f s": "outline::Toggle",
      "space f shift-s": "project_symbols::Toggle",
      "space f c": "command_palette::Toggle",
      "space f t": "theme_selector::Toggle",

      // p – Projekte, Remote/WSL, Konfiguration
      "space p r": ["projects::OpenRecent", { "create_new_window": false }],
      "space p o": "projects::OpenRemote",
      "space p s": "zed::OpenSettings",
      "space p k": "zed::OpenKeymap",
      "space p t": "zed::OpenTasks",
      "space p d": "zed::OpenDebugTasks",

      // Panels
      "space e": "project_panel::ToggleFocus",
      "space shift-e": "pane::RevealInProjectPanel",
      "space o": "outline_panel::ToggleFocus",
      "space q": "pane::CloseActiveItem",
      "space shift-q": "pane::CloseOtherItems",

      // w – Fenster / Splits / Docks
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      "space w z": "workspace::ToggleZoom",
      "space w c": "workspace::ToggleCenteredLayout",
      "space w x": "workspace::CloseAllDocks",
      "space w h": "workspace::ToggleLeftDock",
      "space w l": "workspace::ToggleRightDock",
      "space w j": "workspace::ToggleBottomDock",
      "space w f": "zed::ToggleFullScreen",

      // c – Code / LSP
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "diagnostics::Deploy",
      "space c i": "editor::GoToImplementation",
      "space c t": "editor::GoToTypeDefinition",
      "space c u": "editor::FindAllReferences",
      "space c h": "editor::ToggleInlayHints",
      "space c l": "editor::RestartLanguageServer",
      "space c v": "toolchain::Select",

      // g – Git
      "space g g": "git_panel::ToggleFocus",
      "space g b": "editor::ToggleGitBlameInline",
      "space g shift-b": "git::Blame",
      "space g d": "git::Diff",
      "space g c": "git::Commit",
      "space g shift-c": "git::ExpandCommitEditor",
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",
      "space g f": "git::Fetch",
      "space g s": "git::ToggleStaged",
      "space g h": "editor::ToggleSelectedDiffHunks",
      "space g r": "git::Restore",
      "space g o": "git::Branch",
      "space g l": ["task::Spawn", { "task_name": "lazygit", "reveal_target": "center" }],

      // r – Run / Tasks (gleiche Namen in allen Projektvorlagen!)
      "space r r": ["task::Spawn", { "task_name": "dev: run" }],
      "space r b": ["task::Spawn", { "task_name": "dev: build" }],
      "space r t": ["task::Spawn", { "task_name": "dev: test" }],
      "space r l": ["task::Spawn", { "task_name": "dev: lint" }],
      "space r f": ["task::Spawn", { "task_name": "dev: format" }],
      "space r n": "editor::SpawnNearestTask",
      "space r s": "task::Spawn",
      "space r a": ["task::Rerun", { "reevaluate_context": true }],

      // t – Terminal
      "space t t": "terminal_panel::ToggleFocus",
      "space t n": "workspace::NewTerminal",

      // d – Debug
      "space d d": "debugger::Start",
      "space d b": "editor::ToggleBreakpoint",
      "space d l": "editor::EditLogBreakpoint",
      "space d c": "debugger::Continue",
      "space d o": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d u": "debugger::StepOut",
      "space d p": "debugger::Pause",
      "space d s": "debugger::Stop",
      "space d r": "debugger::Rerun",
      "space d shift-r": "debugger::Restart",
      "space d v": "debugger::FocusVariables",
      "space d e": "debugger::FocusConsole",
      "space d t": "debug_panel::ToggleFocus",

      // a – KI
      "space a a": "agent::ToggleFocus",
      "space a n": "agent::NewThread",
      "space a c": ["agent::NewExternalAgentThread", { "agent": { "custom": { "name": "claude-acp" } } }],
      "space a p": ["agent::NewExternalAgentThread", { "agent": { "custom": { "name": "pi-acp" } } }],
      "space a m": "agent::ToggleModelSelector",
      "space a i": "assistant::InlineAssist",
      "space a s": "agent::AddSelectionToThread",
      "space a t": "editor::ToggleEditPrediction",
      "space a shift-c": ["task::Spawn", { "task_name": "Claude Code (Terminal)", "reveal_target": "center" }],
      "space a shift-p": ["task::Spawn", { "task_name": "pi (Terminal)", "reveal_target": "center" }],

      // m – Markdown
      "space m p": "markdown::OpenPreviewToTheSide"
    }
  },

  // ── Vim Normal + Visual ───────────────────────────────────────────────────
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "f9": "editor::ToggleBreakpoint",

      // Jump-to-word (Helix-Style, Zed PR #43733): Labels erscheinen an den
      // Wörtern im sichtbaren Bereich, Label tippen = dorthin springen.
      // Landet am Wortende mit markiertem Wort (Visual) – danach Esc, ggf. b.
      // Achtung: überschreibt `g w` (Umbrechen/Rewrap). Alternative: "g z".
      "g w": "vim::HelixJumpToWord"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "-": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "shift-s": "vim::PushAddSurrounds"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::NormalBefore",
      "alt-\\": "editor::ShowEditPrediction"
    }
  },

  // ── KI-Vorschläge (Ghost-Text) annehmen ───────────────────────────────────
  {
    "context": "Editor && (edit_prediction || edit_prediction_conflict)",
    "bindings": {
      "ctrl-alt-l": "editor::AcceptEditPrediction",
      "alt-w": "editor::AcceptNextWordEditPrediction",
      "ctrl-alt-j": "editor::AcceptNextLineEditPrediction"
    }
  },

  // ── Terminal: ctrl+alt+hjkl statt ctrl (ctrl-h/l/k/w braucht die Shell) ───
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-h": "workspace::ActivatePaneLeft",
      "ctrl-alt-l": "workspace::ActivatePaneRight",
      "ctrl-alt-k": "workspace::ActivatePaneUp",
      "ctrl-alt-j": "workspace::ActivatePaneDown",
      // Fallback für Windows, wo Ctrl+Alt (= AltGr) von Zed teils nicht ankommt
      "ctrl-shift-h": "workspace::ActivatePaneLeft",
      "ctrl-shift-l": "workspace::ActivatePaneRight",
      "ctrl-shift-k": "workspace::ActivatePaneUp",
      "ctrl-shift-j": "workspace::ActivatePaneDown",
      "alt-z": "workspace::ToggleZoom"
    }
  },

  // ── Panels ohne Editor: ctrl+hjkl zum Wechseln ────────────────────────────
  {
    "context": "ProjectPanel || OutlinePanel || GitPanel",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // ── Projekt-Panel (netrw/oil-artig) ───────────────────────────────────────
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": ["project_panel::Delete", { "skip_prompt": false }],
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "shift-d": "project_panel::Duplicate",
      "/": "project_panel::NewSearchInDirectory",
      "q": "workspace::ToggleLeftDock"
    }
  }
]
